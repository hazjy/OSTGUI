<Page
    x:Class="OSTGUI.Pages.DenuvoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,12">
            <TextBlock Text="D加密授权管理" FontSize="24" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:Segmented Grid.Row="0" x:Name="DenuvoSegmented"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="DenuvoSegmented_SelectionChanged">
                <controls:SegmentedItem Content="正版账户授权" IsSelected="True" />
                <controls:SegmentedItem Content="导入/导出授权" />
            </controls:Segmented>
            <Grid Grid.Row="1">
                <Grid x:Name="AccountsPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">

                        <StackPanel Spacing="4">
                            <TextBlock Text="我该怎么做？" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="正版账号授权使用说明" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Padding="24" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="20">
                                <TextBlock Text="大致流程" FontSize="20" FontWeight="SemiBold" />

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="获得一个拥有正版游戏的账户" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="买或租/借，购买价格不应超过 5 元，低价优先"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="--注意辨别是不是假入库的所谓“激活码”"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="用正版账号启动一次游戏，看到窗口后退出" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="--" />
                                            <Underline><Run Text="看到窗口" /></Underline>
                                            <Run Text=" 然后退出" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="用自己的账号启动游戏，即可开玩" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="--想省心就锁定游戏版本，否则更新后要重新授权"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="24" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="20">
                                <TextBlock Text="常见问题" FontSize="20" FontWeight="SemiBold" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：如何辨别购物平台账号的真假？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="低价“激活码 / CDK”一律忽略"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：红信账号影响授权吗？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="不影响"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：正版账号授权不了怎么办？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="触发了账户的机器激活限制，可尝试联系卖家更换账户"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：锁定版本要开吗？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="在乎新内容就关，想省心就锁定"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：授权不了会不会是 OSTGUI 的问题？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="不会。授权功能由 OST 内核提供，不由 GUI 实现，GUI 仅提供说明"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <Grid x:Name="TransferPanel" Visibility="Collapsed">
                <Grid Padding="0,16,0,40">
                    <Border Padding="24" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock Text="导入/导出授权 - 内容待定" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
