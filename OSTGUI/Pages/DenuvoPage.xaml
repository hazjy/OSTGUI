<Page
    x:Class="OSTGUI.Pages.DenuvoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:OSTGUI.Helpers"
    >
    <Page.Resources>
        <helpers:BoolNegateConverter x:Key="BoolNegateConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:StatusToBrushConverter x:Key="StatusToBrush" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,12">
            <TextBlock Text="D加密授权管理" FontSize="24" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:Segmented Grid.Row="0" x:Name="DenuvoSegmented"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="DenuvoSegmented_SelectionChanged">
                <controls:SegmentedItem Content="正版账户授权" IsSelected="True" />
                <controls:SegmentedItem Content="导入/导出授权" />
            </controls:Segmented>
            <Grid Grid.Row="1">
                <Grid x:Name="AccountsPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">

                        <StackPanel Spacing="4">
                            <TextBlock Text="我该怎么做？" FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="正版账号授权使用说明" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Border Padding="24" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="20">
                                <TextBlock Text="大致流程" FontSize="20" FontWeight="SemiBold" />

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="获得一个拥有正版游戏的账户" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="买或租/借，购买价格不应超过 5 元，低价优先"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="--注意辨别是不是假入库的所谓“激活码”"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="用正版账号启动一次游戏，看到窗口后退出" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="--" />
                                            <Underline><Run Text="看到窗口" /></Underline>
                                            <Run Text=" 然后退出" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="用自己的账号启动游戏，即可开玩" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="--想省心就锁定游戏版本，否则更新后要重新授权"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="24" CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="20">
                                <TextBlock Text="常见问题" FontSize="20" FontWeight="SemiBold" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：如何辨别购物平台账号的真假？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="低价“激活码 / CDK”一律忽略"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：红信账号影响授权吗？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="不影响"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：正版账号授权不了怎么办？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="触发了账户的机器激活限制，可尝试联系卖家更换账户"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：锁定版本要开吗？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="在乎新内容就关，想省心就锁定"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Q：授权不了会不会是 OSTGUI 的问题？" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="不会。授权功能由 OST 内核提供，不由 GUI 实现，GUI 仅提供说明"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <Grid x:Name="TransferPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">

                            <Border Padding="24" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="导出授权" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="提取当前 Steam 账号的授权数据，导出为可分享的授权文件"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox Header="AppID" PlaceholderText="输入要导出的游戏 AppID"
                                             Text="{Binding ExportAppId, Mode=TwoWay}" />
                                    <Button HorizontalAlignment="Left" Click="ExportOst_Click"
                                            IsEnabled="{Binding IsExporting, Converter={StaticResource BoolNegateConverter}}">
                                        <TextBlock Text="导出授权" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Padding="24" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="导入授权" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="选择授权文件导入，写入本机凭证存储"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Click="ImportOst_Click">
                                            <TextBlock Text="选择文件" />
                                        </Button>
                                        <Button Click="GoOst_Click" Style="{StaticResource AccentButtonStyle}"
                                                IsEnabled="{Binding HasValidOst}">
                                            <TextBlock Text="Go" />
                                        </Button>
                                    </StackPanel>

                                    <Border Padding="16" CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{Binding HasValidOst, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="授权文件信息" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock FontSize="12">
                                                <Run Text="AppID：" /><Run Text="{Binding SelectedOst.AppId}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12">
                                                <Run Text="来源：" /><Run Text="{Binding SelectedOst.Source}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12">
                                                <Run Text="生成：" /><Run Text="{Binding OstCreatedText}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock FontSize="12">
                                                    <Run Text="失效：" /><Run Text="{Binding OstExpiresText}" />
                                                </TextBlock>
                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Text="{Binding OstStatusText}"
                                                           Foreground="{Binding OstStatusType, Converter={StaticResource StatusToBrush}}" />
                                            </StackPanel>
                                            <TextBlock FontSize="12">
                                                <Run Text="使用次数：" /><Run Text="{Binding SelectedOst.UseCount}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12">
                                                <Run Text="导出版本：" /><Run Text="{Binding SelectedOst.ExporterVersion}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="注意：部分游戏的 DLC 也受 D 加密保护，授权文件中没有对应 DLC 授权时，这些 DLC 将无法解锁或启动失败。"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Padding="24" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="重要说明" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                                            Click="ImportantLink_Click">
                                        <TextBlock Text="跳转" />
                                    </Button>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Page>
