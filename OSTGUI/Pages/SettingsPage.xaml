<Page
    x:Class="OSTGUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:OSTGUI.Helpers"
    xmlns:models="using:OSTGUI.Models"
    >
    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Grid Grid.Row="0" Padding="40,24,40,16">
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </Grid>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="40,0,40,40" Spacing="24">

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="基本设置" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Steam 路径" FontSize="13" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SteamPath, Mode=TwoWay}"
                                         PlaceholderText="留空则自动检测"
                                         TextChanged="OnSettingChanged" />
                                <Button Grid.Column="1" Content="浏览" Click="BrowseSteam_Click" />
                                <Button Grid.Column="2" Content="自动检测" Click="DetectSteam_Click" />
                            </Grid>
                        </StackPanel>
                        <CheckBox Content="显示系统通知" IsChecked="{Binding ShowSystemNotifications, Mode=TwoWay}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        <CheckBox Content="版本状态更改通知" IsChecked="{Binding ShowVersionChangeNotifications, Mode=TwoWay}"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    </StackPanel>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="外观设置" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="主题" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="浅色" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                            <RadioButton Content="深色" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                            <RadioButton Content="跟随系统" IsChecked="{Binding IsAutoTheme, Mode=TwoWay}" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="清单源" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="需要密钥的源在此配置 API Key / Token"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 源列表（内置 + 自定义，通用格式） -->
                        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ManifestSource">
                                        <Border Padding="12" CornerRadius="8" Margin="0,4"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Spacing="4"
                                                            Visibility="{Binding RequiresToken, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="API Key / Token" FontSize="12" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <PasswordBox Grid.Column="0" Password="{Binding ApiKey, Mode=TwoWay}"
                                                                     PlaceholderText="可选，留空则不使用"
                                                                     PasswordChanged="OnSettingChanged" />
                                                        <Button Grid.Column="1" Content="获取" Tag="{Binding}"
                                                                Click="OpenTokenPage_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 日志区域 -->
                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行时日志" FontSize="16" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="复制全部" Click="CopyLogs_Click" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="清空" Click="ClearLogs_Click" />
                        </Grid>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,1" IsTextSelectionEnabled="True" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志文件" FontSize="16" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="打开日志文件夹" Click="OpenLogFile_Click" />
                        </Grid>
                        <NumberBox Header="日志保留行数" Minimum="100" Maximum="10000"
                                   SmallChange="100" LargeChange="500"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{Binding LogMaxLines, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
