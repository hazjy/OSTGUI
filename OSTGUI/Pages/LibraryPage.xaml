<Page
    x:Class="OSTGUI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OSTGUI.Models"
    xmlns:helpers="using:OSTGUI.Helpers"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:VersionModeToBrushConverter x:Key="VersionModeToBrushConverter" />
        <helpers:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <MenuFlyout x:Key="MoreMenu">
            <MenuFlyoutItem Text="编辑 Lua" Click="EditLua_Click" />
            <MenuFlyoutItem Text="补齐版本配置" Click="RepairVersionConfig_Click" />
            <MenuFlyoutItem Text="复制 AppID" Click="CopyAppId_Click" />
            <MenuFlyoutItem Text="复制游戏名称" Click="CopyGameName_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="入库信息" Click="InstallInfo_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,12" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="入库管理" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="RefreshButton_Click">
                        <ToolTipService.ToolTip><ToolTip Content="刷新" /></ToolTipService.ToolTip>
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsBusy}" Margin="40,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer Grid.Row="2">
            <ItemsControl Margin="40,12" ItemsSource="{Binding LibraryItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryItem">
                        <Border Margin="0,4" Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding GameName}" FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                            <Button Click="Repair_Click" Tag="{Binding}"
                                                    ToolTipService.ToolTip="自动修复"
                                                    Background="Transparent" BorderThickness="0" Padding="6,2"
                                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ErrorLabel}" FontSize="11" Margin="0,2,0,0"
                                                   MaxWidth="420" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding AppId}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding VersionModeText}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding VersionMode, Converter={StaticResource VersionModeToBrushConverter}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Click="ToggleVersion_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="切换版本模式"
                                            Background="Transparent" BorderThickness="0" Padding="8,4">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    </Button>
                                    <Button Click="Info_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="信息"
                                            Background="Transparent" BorderThickness="0" Padding="8,4">
                                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    </Button>
                                    <Button Click="More_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="更多"
                                            Background="Transparent" BorderThickness="0" Padding="8,4">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    </Button>
                                    <Button Click="Delete_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="删除"
                                            Background="Transparent" BorderThickness="0" Padding="8,4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
