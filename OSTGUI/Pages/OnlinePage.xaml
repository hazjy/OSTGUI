<Page
    x:Class="OSTGUI.Pages.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,12">
            <TextBlock Text="联机" FontSize="24" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:Segmented Grid.Row="0" x:Name="OnlineSegmented"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnlineSegmented_SelectionChanged">
                <controls:SegmentedItem Content="480联机" IsSelected="True" />
                <controls:SegmentedItem Content="其他" />
            </controls:Segmented>
            <Grid Grid.Row="1">
                <Grid x:Name="OnlineFixPanel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">
                            <TextBlock Text="功能开发中"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="OtherPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">
                            <TextBlock Text="功能开发中"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
