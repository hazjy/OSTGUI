<Application
    x:Class="OSTGUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="OstAccentBrush" Color="#0078d4" />
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#10893e" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#e81123" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#ff8c00" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#0078d4" />
            <SolidColorBrush x:Key="FixedVersionBrush" Color="#e81123" />
            <SolidColorBrush x:Key="AutoVersionBrush" Color="#10893e" />
        </ResourceDictionary>
    </Application.Resources>
</Application>