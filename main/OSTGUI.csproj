<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SteamApi/ 里的 SAM 封装（zlib）用 unsafe 处理原生字符串指针 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 关掉 WinUI 自动生成的 Main：我们自己写入口点（main/Program.cs），
         目的是让监控子进程（trainer-monitor 参数）在 WinUI 初始化之前就返回（省掉整个 UI 栈的内存） -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>1.7.5</Version>
    <AssemblyVersion>1.7.5.0</AssemblyVersion>
    <FileVersion>1.7.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoSteamLauncher\NoSteamLauncher.csproj" />
    <!-- 宿主是**独立进程**（靠 Process.Start 拉起），不要把它的代码合并进 OSTGUI.exe：
         AOT 下合并会让 OnlineHost.dll 不再作为文件发布，宿主成了"启动即失败的空壳"，
         而调用方即发即忘 —— 联机 DLL 注入与 AppID Changer 会全废且毫无报错（2026-09-28 实测）。
         这里只保留构建顺序依赖；可运行的产物由下面两个目标单独拷。 -->
    <ProjectReference Include="..\OnlineHost\OnlineHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\important.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- 关于弹窗的应用图标（ZSteamTool\docs\logo\logo-512.png 的原件副本，RGBA 透明底） -->
    <Content Include="Assets\logo-512.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 关于弹窗「开源许可」要打开的随包许可文本（源文件在仓库根） -->
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 免育碧：Goldberg R2 模拟器预编译 DLL（LGPL-3.0，自编译自 RefProjects/1-在用/Goldberg_r2_extended，见 THIRD-PARTY-NOTICES） -->
    <EmbeddedResource Include="Assets\Ubisoft\upc_r2_loader64.dll" />
  </ItemGroup>

  <!-- MSBuild Publish 默认漏复制 WinUI 应用的 .xbf / OSTGUI.pri，
       缺失会导致启动时 XamlParseException、窗口创建失败；发布后自动补齐。
       注意 .xbf 要按目录递归取（Pages、Views 以及以后新增的任何子目录），
       只写 Pages\*.xbf 会让新目录下的视图编译资源漏掉。 -->
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <!-- Exclude 掉 publish 自身：它在 TargetDir 之下，不排除会递归复制出 publish\publish -->
      <_WinUiXbf Include="$(TargetDir)**\*.xbf" Exclude="$(PublishDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetDir)App.xbf;$(TargetDir)MainWindow.xbf;$(TargetDir)OSTGUI.pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUiXbf)" DestinationFiles="@(_WinUiXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- ── 宿主产物的拷贝（见上面 OnlineHost 的 ProjectReference 注释）─────────────────
       路径由 Directory.Build.props 统一规定为 .build\<工程名>\bin\<配置>\<TFM>\win-x64\。
       宿主是独立进程，必须让它的**可运行产物**跟着输出目录走，否则联机会静默失效；
       所以文件清单在目标里解析（存在性检查要等 OnlineHost 构建完才有意义）。 -->
  <PropertyGroup>
    <_OnlineHostOutDir>$(_RepoRoot).build\OnlineHost\bin\$(Configuration)\$(TargetFramework)\win-x64\</_OnlineHostOutDir>
  </PropertyGroup>

  <Target Name="_ResolveOnlineHostFiles">
    <ItemGroup>
      <!-- 照搬宿主产物目录里的全部文件：它的 TFM 是 windows 版，还会带 WinRT.Runtime.dll /
           Microsoft.Windows.SDK.NET.dll 这类传递依赖，手写清单会漏（2026-09-28 实测漏过一次）。 -->
      <_OnlineHostFile Include="$(_OnlineHostOutDir)*" />
    </ItemGroup>
  </Target>

  <Target Name="CopyOnlineHostToOutput" AfterTargets="Build" DependsOnTargets="_ResolveOnlineHostFiles">
    <Copy SourceFiles="@(_OnlineHostFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Warning Text="OnlineHost 产物不存在（$(_OnlineHostOutDir)）：联机 DLL 注入与 AppID Changer 会失效"
             Condition="!Exists('$(_OnlineHostOutDir)OnlineHost.exe')" />
  </Target>

  <!-- 普通（非 AOT）发布也用 JIT 版宿主；AOT 发布由 publish-aot.bat 里的宿主 AOT 步骤负责。 -->
  <Target Name="CopyOnlineHostToPublish" AfterTargets="Publish" DependsOnTargets="_ResolveOnlineHostFiles"
          Condition="'$(PublishDir)' != '' And '$(PublishAot)' != 'true'">
    <Copy SourceFiles="@(_OnlineHostFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
