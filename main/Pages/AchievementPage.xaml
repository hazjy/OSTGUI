<Page
    x:Class="OSTGUI.Pages.AchievementPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40,32,40,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="成就" FontSize="32" FontWeight="Bold" />
            <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="需要 Steam 在线；点击「保存到 Steam」才会实际生效" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：已入库游戏 -->
            <Border Grid.Column="0" Padding="12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PlaceholderText="AppID/名称"
                                 Text="{Binding Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="刷新"
                                ToolTipService.ToolTip="重新扫描游戏列表"
                                Width="32" Height="32" MinWidth="0" Padding="0"
                                Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                        <CheckBox Grid.Column="2" MinWidth="0" Content="lua" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowLua, Mode=TwoWay}"
                                  ToolTipService.ToolTip="显示入库（lua）的游戏" />
                        <CheckBox Grid.Column="3" MinWidth="0" Content="正版" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowOwned, Mode=TwoWay}"
                                  ToolTipService.ToolTip="显示客户端认为你拥有的游戏" />
                    </Grid>

                    <ListView Grid.Row="1" SelectionMode="Single"
                              ItemsSource="{Binding Games}"
                              SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6" Spacing="2">
                                    <TextBlock Text="{Binding GameName}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding AppIdDisplay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding SourceTag}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右：成就列表 -->
            <Border Grid.Column="1" Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="10">
                        <TextBlock Text="{Binding GameTitle}" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressBar Width="220" Maximum="1" Value="{Binding ProgressValue}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding DirtyText}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <ProgressRing IsActive="{Binding IsBusy}" Width="18" Height="18" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="全部解锁" Command="{Binding UnlockAllCommand}" />
                            <Button Content="全部锁定" Command="{Binding LockAllCommand}" />
                            <Button Content="保存到 Steam" Command="{Binding SaveToSteamCommand}" IsEnabled="{Binding SteamRunning}" />
                            <Button Content="从 Steam 读取" Command="{Binding ReadFromSteamCommand}" IsEnabled="{Binding SteamRunning}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- InfoBar 自带的严重度配色在浅色下是"深底 + 深字"（看不清），
                         直接套卡片配色，警示感由图标颜色传达 -->
                    <InfoBar Grid.Row="1" IsClosable="False" IsOpen="{Binding HasNotice}"
                             Severity="{Binding NoticeSeverity}" Message="{Binding Notice}"
                             Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                             BorderThickness="1" CornerRadius="8" />

                    <TextBox Grid.Row="2" PlaceholderText="按成就名称或描述过滤"
                             Text="{Binding RowFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ListView Grid.Row="3" SelectionMode="None" ItemsSource="{Binding VisibleRows}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontSize="24" VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding UnlockText}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="2" MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                                  IsChecked="{Binding Achieved, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
