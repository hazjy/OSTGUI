<Page
    x:Class="OSTGUI.Pages.NoSteamPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:OSTGUI.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StrToVis" />
        <converters:IntToDoubleConverter x:Key="IntToDoubleConverter" />
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <Style TargetType="TextBox" x:Key="InputBoxStyle">
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 固定标题栏 -->
        <StackPanel Grid.Row="0" Margin="40,32,40,12">
            <TextBlock Text="模拟器" FontSize="24" FontWeight="Bold" />
        </StackPanel>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="40,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:Segmented Grid.Row="0" x:Name="NoSteamSegmented"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="NoSteamSegmented_SelectionChanged">
                <controls:SegmentedItem Content="免Steam" IsSelected="True" />
                <controls:SegmentedItem Content="免育碧（实验性）" />
            </controls:Segmented>

            <ScrollViewer Grid.Row="1" x:Name="NoSteamPanel" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Center">

                    <!-- 焦点锚点：WinUI 空白点击会把焦点投给 ScrollViewer 内第一个可聚焦控件（#4364），
                         此处拦截，避免落到 EXE/AppID 输入框 -->
                    <Grid IsTabStop="True" TabIndex="0" Width="1" Height="1"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="游戏选择" FontSize="16" FontWeight="SemiBold" />

                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏 EXE:" Style="{StaticResource LabelStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GameExePath, Mode=TwoWay}"
                                         Style="{StaticResource InputBoxStyle}" PlaceholderText="选择游戏主程序 .exe" IsReadOnly="True" />
                                <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Command="{Binding BrowseGameExeCommand}"
                                        Margin="0,4,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="AppID:" Style="{StaticResource LabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AppId, Mode=TwoWay}"
                                         Style="{StaticResource InputBoxStyle}" PlaceholderText="Steam AppID"
                                         InputScope="Number" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16,12,16,12" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="部署选项" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="设置"
                                    Command="{Binding OpenDeploymentOptionsCommand}"
                                    VerticalAlignment="Center" Margin="0"
                                    Style="{StaticResource DefaultButtonStyle}" />
                            <Button Grid.Column="2" Content="更多配置"
                                    Command="{Binding OpenAdvancedConfigCommand}"
                                    VerticalAlignment="Center" Margin="0"
                                    Style="{StaticResource DefaultButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="高级设置" FontSize="16" FontWeight="SemiBold" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Steamless 超时 (分钟):" Style="{StaticResource LabelStyle}" />
                                <NumberBox Grid.Column="1" Value="{Binding SteamlessTimeoutMinutes, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}"
                                           Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="开始部署" Command="{Binding DeployCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="140" Height="40" FontSize="14" />
                        <Button Content="清空日志" Command="{Binding ClearLogCommand}"
                                Width="100" Height="40" FontSize="14" />
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="部署日志" FontSize="16" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ProgressLog, Mode=OneWay}"
                                     IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                                     MinHeight="200" MaxHeight="400"
                                     Background="{ThemeResource TextControlBackgroundFocused}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 免育碧：Goldberg R2 模拟器部署（Phase 1） -->
            <Grid Grid.Row="1" x:Name="UbisoftPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Center" Padding="0,16,0,40">
                        <!-- 焦点锚点：WinUI 空白点击会把焦点投给 ScrollViewer 内第一个可聚焦控件（#4364），
                             此处拦截，避免落到"游戏目录"输入框（与 NoSteamPanel 等其余面板一致） -->
                        <Grid IsTabStop="True" TabIndex="0" Width="1" Height="1"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="免育碧 · Goldberg R2 模拟器（实验性）" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="实验性功能：基于 Goldberg R2 模拟器替换 uplay/upc loader，无需运行 Ubisoft Connect 即可启动。仅适用于传统单 loader 的育碧 R2 游戏；多组件 UC 栈（如 UNO：ubiservices/uprofile/dbdata）暂不支持，本功能处于挂起状态（待上游 ServerEmus 生态成熟后再评估）。无 D 加密游戏可直接游玩；D 加密游戏需先在正版环境激活一次。"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UbisoftDirBox" Grid.Column="0" Header="游戏目录"
                                             PlaceholderText="选择游戏安装目录（含 uplay_r2_loader64.dll）" />
                                    <Button Grid.Column="1" Content="浏览…" Click="BrowseUbisoftDir_Click"
                                            VerticalAlignment="Bottom" />
                                </Grid>

                                <TextBlock x:Name="UbisoftLoaderStatus" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="开始部署" Click="DeployUbisoft_Click"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="还原" Click="RestoreUbisoft_Click" />
                                </StackPanel>

                                <TextBox x:Name="UbisoftLogBox" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                                         MinHeight="140" MaxHeight="260"
                                         Background="{ThemeResource TextControlBackgroundFocused}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
