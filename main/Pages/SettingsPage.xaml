<Page
    x:Class="OSTGUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:OSTGUI.Helpers"
    xmlns:models="using:OSTGUI.Models"
    >
    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Grid Grid.Row="0" Padding="40,24,40,16">
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </Grid>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="40,0,40,40" Spacing="24">
                <!-- 焦点锚点：WinUI 点击空白会把焦点丢给 ScrollViewer 内第一个可聚焦控件
                     （microsoft-ui-xaml #4364），此 1×1 透明锚点抢在 Steam 路径输入框之前接收焦点，避免误激活输入框 -->
                <Grid IsTabStop="True" TabIndex="0" Width="1" Height="1"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="基本设置" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SteamPathDisplay, Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Lua 路径：" FontSize="13" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding LuaPath, Mode=TwoWay}"
                                         PlaceholderText="默认路径"
                                         LostFocus="OnLuaPathLostFocus" />
                                <Button Grid.Column="2" Content="浏览" Click="BrowseLua_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <CheckBox Content="入库结果通知" IsChecked="{Binding ShowSystemNotifications, Mode=TwoWay}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                            <CheckBox Content="版本状态更改通知" IsChecked="{Binding ShowVersionChangeNotifications, Mode=TwoWay}"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="D 加密模式" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="身份模式" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton GroupName="DenuvoMode" Content="普通模式"
                                             IsChecked="{Binding IsDenuvoNormalMode, Mode=TwoWay}" />
                                <RadioButton GroupName="DenuvoMode" Content="兼容模式"
                                             IsChecked="{Binding IsDenuvoCompatMode, Mode=TwoWay}" />
                            </StackPanel>
                            <TextBlock Text="普通模式：授权窗口外按你当前登录的账号运行，游戏存档 / 云存档绑定你自己的账号（推荐）"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="兼容模式：整场按票据所属账号运行，供少数仍会复验身份的严格标题使用；该游戏的存档 / 云存档会绑定出票账号"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding DenuvoConfigPath, Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <TextBlock Text="外观设置" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="主题" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="浅色" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                            <RadioButton Content="深色" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                            <RadioButton Content="跟随系统" IsChecked="{Binding IsAutoTheme, Mode=TwoWay}" />
                        </StackPanel>
                        </StackPanel>

                        <!-- 侧边栏宽度（UI 先行，交互逻辑待接入：CanApplyNavigationPaneWidth/点击保存） -->
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Header="侧边栏宽度" Width="180"
                                         Text="{Binding NavigationPaneWidthInput, Mode=TwoWay}" />
                                <Button Content="更改" VerticalAlignment="Bottom" Click="ApplyNavigationPaneWidth_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{Binding CanApplyNavigationPaneWidth}" />
                            </StackPanel>
                            <TextBlock Text="范围 150–600 像素，修改后立即生效并保存"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="清单源" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="需要密钥的源在此配置 API Key / Token"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 源列表（内置 + 自定义，通用格式） -->
                        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ManifestSource">
                                        <Border Padding="12" CornerRadius="8" Margin="0,4"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                        <TextBlock Text="|" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Content="刷新缓存" Click="RefreshSudamaCache_Click"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding ShowRefreshCacheButton, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="导入文件…" Click="ImportSudamaCache_Click"
                                                                Tag="{Binding}"
                                                                Visibility="{Binding ShowRefreshCacheButton, Converter={StaticResource BoolToVis}}"
                                                                ToolTipService.ToolTip="在浏览器下载好 depotkeys.json / appaccesstokens.json 后，选择文件直接导入（自动识别类型），无需应用内下载" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding SudamaCacheAgeText}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding ShowRefreshCacheButton, Converter={StaticResource BoolToVis}}" />
                                                <StackPanel Spacing="4"
                                                            Visibility="{Binding RequiresToken, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="API Key / Token" FontSize="12" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <PasswordBox Grid.Column="0" Password="{Binding ApiKey, Mode=TwoWay}"
                                                                     PlaceholderText="可选，留空则不使用"
                                                                     GotFocus="OnTokenGotFocus"
                                                                     LostFocus="OnTokenLostFocus" />
                                                        <Button Grid.Column="1" Content="获取" Tag="{Binding}"
                                                                Click="OpenTokenPage_Click" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding ApiKeyUpdatedAtText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding ShowApiKeyUpdatedAt, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 日志区域 -->
                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行时日志" FontSize="16" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="复制全部" Click="CopyLogs_Click" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="清空" Click="ClearLogs_Click" />
                        </Grid>
                        <TextBox x:Name="LogsTextBox"
                                 Text="{Binding LogsText, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Code, Consolas" FontSize="12"
                                 MinHeight="200" MaxHeight="400"
                                 Background="{ThemeResource TextControlBackgroundFocused}" />
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志文件" FontSize="16" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="打开日志文件夹" Click="OpenLogFile_Click" />
                        </Grid>
                        <NumberBox Header="日志保留行数" Minimum="100" Maximum="10000"
                                   SmallChange="100" LargeChange="500"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{Binding LogMaxLines, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
