<Page
    x:Class="OSTGUI.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:OSTGUI.Helpers"
    xmlns:models="using:OSTGUI.Models"
    >
    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:BoolNegateConverter x:Key="BoolNegateConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 固定区：标题、入库选项、搜索框（不随滚动移动） -->
        <StackPanel Grid.Row="0" Margin="40,32,40,12" Spacing="20">

            <!-- 标题和入库选项 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="搜索入库" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
                    <CheckBox Content="添加所有DLC" IsChecked="{Binding AddAllDlc, Mode=TwoWay}" />
                    <CheckBox Content="写入固定版本配置" IsChecked="{Binding FixedVersion, Mode=TwoWay}" />
                    <CheckBox Content="下载 Manifest" IsChecked="{Binding DownloadManifest, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- 搜索框 -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox"
                         PlaceholderText="输入游戏名称、AppID 或 Steam 链接"
                         FontSize="14"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         KeyDown="SearchBox_KeyDown" />
                <Button Grid.Column="1" Click="SearchButton_Click" IsEnabled="{Binding IsSearching, Converter={StaticResource BoolNegateConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="搜索" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />

            <!-- 入库流程加载条（搜索框下方，入库结束自动消失） -->
            <ProgressBar x:Name="AddProgress" IsIndeterminate="True"
                         Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- 滚动区：仅搜索结果与无结果提示 -->
        <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,4,40,40" Spacing="20">

                <!-- 搜索结果（独立卡片） -->
                <ItemsControl ItemsSource="{Binding SearchResults}"
                              Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResult">
                            <Border Padding="15,12" MinHeight="80" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 缩略图：来源与入库封面完全同一套（460×215 header），只走内存不落盘；
                                         没图时露出手柄占位（Image 直接盖在 FontIcon 上，不需要 null 判断转换器）。
                                         这里用 Uniform 是保险：万一官方给了别的比例，宁可留边也不裁切 -->
                                    <Border Grid.Column="0" Width="120" Height="56" CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE7FC;" FontSize="24"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding AppIdDisplay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <!-- 纯图标按钮（icon-only Button）。字形是自绘的"箭头落进托盘"：
                                             Segoe Fluent Icons 里没有这个形状（E896 只是"箭头+一条直横线"，
                                             E78C 是软盘+圆形角标、EBD3 是云+圆圈箭头），所以用 16×16 描边路径画一个。
                                             Path 不继承 Foreground，描边色显式给主题画刷（与 FontIcon 默认一致） -->
                                        <Button Click="ListAddGame_Click" Tag="{Binding}"
                                                ToolTipService.ToolTip="入库"
                                                Width="32" Height="32" MinWidth="0" Padding="0"
                                                Background="Transparent" BorderThickness="0">
                                            <Path Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M8,1.8 L8,9.4 M4.7,6.3 L8,9.6 L11.3,6.3 M2.3,11.3 L2.3,13.2 A1.7,1.7 0 0 0 4,14.9 L12,14.9 A1.7,1.7 0 0 0 13.7,13.2 L13.7,11.3" />
                                        </Button>
                                        <Button Click="InfoButton_Click" Tag="{Binding}"
                                                ToolTipService.ToolTip="信息"
                                                Width="32" Height="32" MinWidth="0" Padding="0"
                                                Background="Transparent" BorderThickness="0">
                                            <FontIcon Glyph="&#xE946;" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 无结果提示 -->
                <Border Padding="24" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="超时或无结果" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
