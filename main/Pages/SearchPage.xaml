<Page
    x:Class="OSTGUI.Pages.SearchPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:OSTGUI.Helpers"
    xmlns:models="using:OSTGUI.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    >
    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:BoolNegateConverter x:Key="BoolNegateConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 画刷取样点：代码里换"悬浮高亮"背景时按**应用主题**取（Application.Current.Resources 走系统主题，
             浅色应用 + 深色系统会取到深色画刷）。做法与入库管理页一致 -->
        <Border x:Name="ProbeCardHover" Grid.RowSpan="2" Visibility="Collapsed" Width="1" Height="1"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />

        <!-- 固定区：标题、入库选项、搜索框（不随滚动移动） -->
        <StackPanel Grid.Row="0" Margin="40,32,40,12" Spacing="20">

            <!-- 标题和入库选项 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="搜索入库" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
                    <CheckBox Content="添加所有DLC" IsChecked="{Binding AddAllDlc, Mode=TwoWay}" />
                    <CheckBox Content="写入固定版本配置" IsChecked="{Binding FixedVersion, Mode=TwoWay}" />
                    <CheckBox Content="下载 Manifest" IsChecked="{Binding DownloadManifest, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <!-- 搜索框 + 视图切换（纯图标，与入库管理同款） -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox"
                         PlaceholderText="输入游戏名称、AppID 或 Steam 链接"
                         FontSize="14"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         KeyDown="SearchBox_KeyDown" />
                <Button Grid.Column="1" Click="SearchButton_Click" IsEnabled="{Binding IsSearching, Converter={StaticResource BoolNegateConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="搜索" />
                    </StackPanel>
                </Button>

                <!-- 视图切换：纯图标（没有文字 → 必须给 AutomationProperties.Name，否则 UIA 读不到）；
                     不要 HorizontalAlignment="Stretch"，那是整行分页用法，会把两枚图标拉散 -->
                <controls:Segmented x:Name="ViewSegmented" Grid.Column="2" VerticalAlignment="Center"
                                    SelectionChanged="ViewSegmented_SelectionChanged">
                    <controls:SegmentedItem AutomationProperties.Name="列表视图"
                                            ToolTipService.ToolTip="列表视图">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                    <controls:SegmentedItem AutomationProperties.Name="网格视图"
                                            ToolTipService.ToolTip="网格视图">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xF0E2;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                </controls:Segmented>
            </Grid>

            <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />

            <!-- 入库流程加载条（搜索框下方，入库结束自动消失） -->
            <ProgressBar x:Name="AddProgress" IsIndeterminate="True"
                         Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}" />

            <!-- 取消任务：只在入库进行中出现（IsAdding）。用默认 Button 样式（填充 + 1px 描边 + 圆角，
                 自带 hover/pressed 反馈，所以不手工改画刷）；文字与图标走强调色，对齐用户给的参考图。
                 图标 E7A7 = Undo（弯钩左箭头）—— Segoe Fluent Icons 里最接近参考图那个形状的
                 （E7A6 是它的镜像、E10E 是另一种"返回"箭头）。 -->
            <Button x:Name="CancelAddButton" Click="CancelAddButton_Click"
                    AutomationProperties.Name="取消任务"
                    IsEnabled="{Binding IsCancelling, Converter={StaticResource BoolNegateConverter}}"
                    HorizontalAlignment="Stretch" CornerRadius="8" MinHeight="44"
                    ToolTipService.ToolTip="中止本次入库（已下载的临时清单会被清理）"
                    Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding CancelButtonText}" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 结果区：列表 / 网格两档宿主**共用**同一份 SearchResults，靠 Visibility 二选一（与入库管理同构）。
             改成 ListView/GridView 后滚动与虚拟化由控件负责，页头（Row0）照旧固定不动。
             缩略图仍是**内存路径**（SearchViewModel 拉字节 → 按原生尺寸解码），两档共用同一张位图、
             切档不重新联网，也**不落盘**（搜索页不做封面缓存，这是明确约定）。 -->
        <ListView x:Name="ResultList" Grid.Row="1" Margin="40,4,40,36"
                  ItemsSource="{Binding SearchResults}"
                  Background="Transparent"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
            <ListView.ItemContainerStyle>
                <!-- 抹掉容器自带内边距；左右各留 10：悬浮放大时卡片要往两边长，不留会被视口边界切掉（与入库管理同值） -->
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="10,6" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchResult">
                    <Border Padding="15,12" MinHeight="80" CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            RenderTransformOrigin="0.5,0.5"
                            PointerEntered="ListCard_PointerEntered"
                            PointerExited="ListCard_PointerExited">
                        <!-- 悬浮放大靠这个变换（Storyboard 在代码里建，见 Helpers/CardHover.cs） -->
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <Grid ColumnSpacing="15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 缩略图：来源与入库封面完全同一套（460×215 header），只走内存不落盘；
                                         没图时露出手柄占位（Image 直接盖在 FontIcon 上，不需要 null 判断转换器）。
                                         这里用 Uniform 是保险：万一官方给了别的比例，宁可留边也不裁切 -->
                                    <Border Grid.Column="0" Width="120" Height="56" CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE7FC;" FontSize="24"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding AppIdDisplay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <!-- 纯图标按钮（icon-only Button）。字形是自绘的"箭头落进托盘"：
                                             Segoe Fluent Icons 里没有这个形状（E896 只是"箭头+一条直横线"，
                                             E78C 是软盘+圆形角标、EBD3 是云+圆圈箭头），所以用 16×16 描边路径画。
                                             坐标是**算出来的**，不是手调：真机 225% DPI 实测两者的墨迹框 ——
                                               字形 E946（FontSize=16）：墨迹 34×34 物理 = 15.11×15.11 逻辑，
                                                 中心相对按钮中心 (−0.44,−0.44) 逻辑；描边 1.06 逻辑
                                               自绘 Path（原坐标）：墨迹 30×34 物理 = 13.33×15.11 逻辑，
                                                 中心相对按钮中心 (+0.44,+0.89) 逻辑；描边 1.6 逻辑
                                             → 需要平移 (−0.88,−1.33) 使中心重合、按 15.11 高度等比放大 1.064、
                                               描边由 1.6 收到 1.1（对齐字形笔画粗细）；
                                               并给 Path 显式 16×16 盒子 + Stretch=None，
                                               否则盒子由几何范围推出、平移不生效（盒子会被重新居中）
                                             ⚠️ 改这里的坐标要重新量（阈值 110 扫墨迹框），别手调 -->
                                        <Button Click="ListAddGame_Click" Tag="{Binding}"
                                                ToolTipService.ToolTip="入库"
                                                Width="32" Height="32" MinWidth="0" Padding="0"
                                                Background="Transparent" BorderThickness="0">
                                            <Path Width="16" Height="16" Stretch="None"
                                                  Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                  StrokeThickness="1.1"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M7.56,0.59 L7.56,8.68 M4.05,5.38 L7.56,8.89 L11.07,5.38 M1.5,10.7 L1.5,12.72 A1.81,1.81 0 0 0 3.3,14.53 L11.82,14.53 A1.81,1.81 0 0 0 13.62,12.72 L13.62,10.7" />
                                        </Button>
                                        <Button Click="InfoButton_Click" Tag="{Binding}"
                                                ToolTipService.ToolTip="信息"
                                                Width="32" Height="32" MinWidth="0" Padding="0"
                                                Background="Transparent" BorderThickness="0">
                                            <FontIcon Glyph="&#xE946;" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 网格视图：卡片尺寸/间距/悬浮数值与入库管理完全一致（封面框 200×93 = 比例 2.1505 ≥ 素材 2.1395，不裁左右）。
             ⚠️ 封面用 Stretch="Uniform"（宁可留边不裁）：搜索结果的缩略图可能来自官方 appdetails 兜底、
             比例不一定是 460×215，而入库管理那份自建缓存永远是 460×215 才敢用 UniformToFill -->
        <GridView x:Name="ResultGrid" Grid.Row="1" Margin="40,4,40,36"
                  ItemsSource="{Binding SearchResults}"
                  Background="Transparent"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 212×222 = 卡片 200×210 + 四边各 6 间距（与入库管理同尺寸） -->
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="212" ItemHeight="222" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="6,6,6,6" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchResult">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="6"
                            RenderTransformOrigin="0.5,0.5"
                            PointerEntered="GridCard_PointerEntered"
                            PointerExited="GridCard_PointerExited">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <StackPanel>
                            <Border Height="93" CornerRadius="6,6,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE7FC;" FontSize="24"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <StackPanel Padding="10,8,10,10" Spacing="6">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding AppIdDisplay}" FontSize="12" TextAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <!-- 两个按钮与列表卡完全一致（同一批处理器）。Path 的坐标来历见列表卡里那段长注释，别手调 -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Click="ListAddGame_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="入库"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <Path Width="16" Height="16" Stretch="None"
                                              Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                              StrokeThickness="1.1"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Data="M7.56,0.59 L7.56,8.68 M4.05,5.38 L7.56,8.89 L11.07,5.38 M1.5,10.7 L1.5,12.72 A1.81,1.81 0 0 0 3.3,14.53 L11.82,14.53 A1.81,1.81 0 0 0 13.62,12.72 L13.62,10.7" />
                                    </Button>
                                    <Button Click="InfoButton_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="信息"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 无结果提示（两档共用） -->
        <Border Grid.Row="1" Padding="24" CornerRadius="12" Margin="40,4,40,40"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="超时或无结果" FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Page>
