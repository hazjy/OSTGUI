<Page
    x:Class="OSTGUI.Pages.LibraryPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OSTGUI.Models"
    xmlns:helpers="using:OSTGUI.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    >
    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:VersionModeToBrushConverter x:Key="VersionModeToBrushConverter" />
        <helpers:StatusToBrushConverter x:Key="StatusToBrushConverter" />

        <!-- 卡片外观：Background **必须**由 Style 提供，不能直接写在 Border 属性上 ——
             悬浮高亮结束后代码用 ClearValue 退回这条「{ThemeResource}」引用（见 Helpers/CardHover.cs）。
             写在 Border 属性上就成了本地值，ClearValue 会把 Background 直接清成 null。 -->
        <Style x:Key="CardSurface" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <MenuFlyout x:Key="MoreMenu">
            <MenuFlyoutItem Text="编辑 Lua" Click="EditLua_Click" />
            <MenuFlyoutItem Text="复制 AppID" Click="CopyAppId_Click" />
            <MenuFlyoutItem Text="复制游戏名称" Click="CopyGameName_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="补齐版本配置" Click="RepairVersionConfig_Click" />
            <MenuFlyoutItem Text="入库信息" Click="InstallInfo_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 画刷取样点：代码里搭「入库信息」弹窗内容时按应用主题取画刷用。
             Application.Current.Resources[...] 走的是系统主题（浅色应用 + 深色系统会把弹窗染深）。 -->
        <Grid x:Name="BrushProbe" Grid.Row="0" Visibility="Collapsed" Width="1" Height="1">
            <Border x:Name="ProbeCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <TextBlock x:Name="ProbeSecondary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ProbeSuccess" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            <!-- 悬浮高亮用（代码里换卡片背景时按应用主题取，见 LibraryPage.xaml.cs） -->
            <Border x:Name="ProbeCardHover" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        </Grid>

        <StackPanel Grid.Row="0" Margin="40,32,40,12" Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <!-- 游戏数量挂在标题里，计数用 CJK 角括号「」（U+300C / U+300D）括住 -->
                    <TextBlock Text="{Binding TitleText}" FontSize="32" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <AutoSuggestBox Width="240" QueryIcon="Find"
                                    PlaceholderText="搜索游戏 / AppID"
                                    Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Click="RefreshButton_Click">
                        <ToolTipService.ToolTip><ToolTip Content="刷新" /></ToolTipService.ToolTip>
                        <FontIcon Glyph="&#xE72C;" />
                    </Button>

                    <!-- 视图切换：纯图标（SegmentedItem.Icon 是 IconElement，直接放 FontIcon）。
                         没有文字 → 必须给 AutomationProperties.Name，否则 UIA 读不到这两枚按钮；
                         不要 HorizontalAlignment="Stretch"：那是整行分页的用法，会把两枚图标拉散 -->
                    <controls:Segmented x:Name="ViewSegmented" VerticalAlignment="Center"
                                        SelectionChanged="ViewSegmented_SelectionChanged">
                        <controls:SegmentedItem AutomationProperties.Name="列表视图"
                                                ToolTipService.ToolTip="列表视图">
                            <controls:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                            </controls:SegmentedItem.Icon>
                        </controls:SegmentedItem>
                        <controls:SegmentedItem AutomationProperties.Name="网格视图"
                                                ToolTipService.ToolTip="网格视图">
                            <controls:SegmentedItem.Icon>
                                <FontIcon Glyph="&#xF0E2;" FontSize="16" />
                            </controls:SegmentedItem.Icon>
                        </controls:SegmentedItem>
                    </controls:Segmented>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsBusy}" Margin="40,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <!-- ListView 而不是 ItemsControl：前者虚拟化（卡片滚进视口才实体化），
             配合 code-behind 的 ContainerContentChanging 才能做到"封面按需加载"。
             不虚拟化的话 40 张卡片与图片会在进页面时一次性全建出来，懒加载等于没做 -->
        <ListView x:Name="LibraryList" Grid.Row="2" Margin="40,12"
                  ItemsSource="{Binding LibraryItems}"
                  Background="Transparent"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                  ContainerContentChanging="LibraryList_ContainerContentChanging">
            <ListView.ItemContainerStyle>
                <!-- 抹掉 ListViewItem 自带的容器内边距/最小高度，卡片自己的 Padding/Margin 说了算。
                     左右各留 10：悬浮放大时卡片要往两边长，不留就会被控件视口边界切掉 -->
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="10,4" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LibraryItem">
                        <Border Margin="0,4" Padding="15,12" MinHeight="80"
                                Style="{StaticResource CardSurface}"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5"
                                PointerEntered="ListCard_PointerEntered"
                                PointerExited="ListCard_PointerExited">
                            <!-- 悬浮放大就靠这个变换（Storyboard 在代码里建，见 Helpers/CardHover.cs） -->
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <Grid ColumnSpacing="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 封面：120×56 即 Steam header.jpg 原生比例（460×215）。
                                     底色是无封面时的占位，必须走 ThemeResource —— 用 Application.Current.Resources
                                     取到的是系统主题，浅色应用 + 深色系统会把底色染错 -->
                                <Border Grid.Column="0" Width="120" Height="56" CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <!-- 无封面时露出底下的图标占位（空框看着像坏了）。
                                         Image 直接盖在图标上，不引入 null 判断转换器 -->
                                    <Grid>
                                        <FontIcon Glyph="&#xE7FC;" FontSize="24"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding AppIdDisplay}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding VersionModeText}" FontSize="12"
                                               Foreground="{Binding VersionMode, Converter={StaticResource VersionModeToBrushConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button Click="ToggleVersion_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="切换版本模式"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE895;" FontSize="16" />
                                    </Button>
                                    <Button Click="Info_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="信息"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                                    </Button>
                                    <Button Click="More_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="更多"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    </Button>
                                    <Button Click="Delete_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="删除"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 网格视图：与列表视图共用同一个 ItemsSource，靠 Visibility 二选一。
             固定 ItemWidth/ItemHeight + 自动换行 —— 窗口变宽只是多一列，卡片尺寸不变。
             ⚠️ 别改成"拉伸填满一行"：最大化时卡片会涨到 350+ 逻辑像素，450 物理像素的封面就是
             1.7× 放大、肉眼糊（跟搜索页流解码那次是同一类病） -->
        <GridView x:Name="LibraryGrid" Grid.Row="2" Margin="40,12"
                  ItemsSource="{Binding LibraryItems}"
                  Background="Transparent"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                  ContainerContentChanging="LibraryGrid_ContainerContentChanging">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- 212×222 = 卡片 200×210 + 右下各 12 间距 -->
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="212" ItemHeight="222" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <!-- 同 ListView：抹掉 GridViewItem 自带的 Padding/MinHeight/MinWidth，
                     否则 ItemWidth/ItemHeight 会被容器内边距吃掉，列数与间距全对不上 -->
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <!-- 6+6 = 卡片间距仍是 12；关键是四边都有了余量，悬浮放大不会被视口边界切掉 -->
                    <Setter Property="Margin" Value="6,6,6,6" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:LibraryItem">
                    <Border Style="{StaticResource CardSurface}"
                            CornerRadius="6"
                            RenderTransformOrigin="0.5,0.5"
                            PointerEntered="GridCard_PointerEntered"
                            PointerExited="GridCard_PointerExited">
                        <!-- 悬浮放大就靠这个变换（Storyboard 在代码里建，见 Helpers/CardHover.cs） -->
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                        <StackPanel>
                            <!-- 封面框 198×92（卡片有 1px 描边，内容宽 200−2=198）= 比例 2.152，**必须 ≥ 素材比例
                                 （header.jpg 460×215 = 2.1395）**，否则 UniformToFill 会左右各裁一点：素材四边只有
                                 3px 的细边框，裁掉 1.28px 就让"右边没边了"（2026-09-23 用户实测 shapez 2 报的那条）。
                                 无封面时露出底下的图标占位（空框看着像坏了） -->
                            <Border Height="92" CornerRadius="6,6,0,0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE7FC;" FontSize="24"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Padding="10,8,10,10" Spacing="6">
                                <!-- 三行文本一律居中：用 TextAlignment 而不是 HorizontalAlignment ——
                                     长名字要被 CharacterEllipsis 截断，块本身是撑满卡片宽的，
                                     只有 TextAlignment 能让每一行文字真的居中 -->
                                <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding AppIdDisplay}" FontSize="12"
                                               TextAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding VersionModeText}" FontSize="12"
                                               TextAlignment="Center"
                                               Foreground="{Binding VersionMode, Converter={StaticResource VersionModeToBrushConverter}}" />
                                </StackPanel>

                                <!-- 操作按钮与列表卡片完全一致（同一批 Click 处理器与 MoreMenu） -->
                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                    <Button Click="ToggleVersion_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="切换版本模式"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE895;" FontSize="16" />
                                    </Button>
                                    <Button Click="Info_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="信息"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                                    </Button>
                                    <Button Click="More_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="更多"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    </Button>
                                    <Button Click="Delete_Click" Tag="{Binding}"
                                            ToolTipService.ToolTip="删除"
                                            Width="32" Height="32" MinWidth="0" Padding="0"
                                            Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid></Page>
