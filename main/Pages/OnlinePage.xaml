<Page
    x:Class="OSTGUI.Pages.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,12">
            <TextBlock Text="联机" FontSize="24" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:Segmented Grid.Row="0" x:Name="OnlineSegmented"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnlineSegmented_SelectionChanged">
                <controls:SegmentedItem Content="480联机" IsSelected="True" />
                <controls:SegmentedItem Content="其他" />
            </controls:Segmented>
            <Grid Grid.Row="1">
                <Grid x:Name="OnlineFixPanel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">
                            <Border Padding="24" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="480 联机启动" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="以 Spacewar(480) 身份启动已入库游戏，启用 Steamworks 联机功能（需 Steam 在线）"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <RadioButton x:Name="KernelModeRadio"
                                                     Content="内核模式"
                                                     GroupName="LaunchMode"
                                                     IsChecked="True"
                                                     Checked="KernelMode_Checked" />
                                        <RadioButton x:Name="CompatModeRadio"
                                                     Content="兼容模式"
                                                     GroupName="LaunchMode"
                                                     Checked="CompatMode_Checked" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBox Header="AppID" Width="180"
                                                 Text="{Binding OnlineAppId, Mode=TwoWay}" />
                                        <Button Content="查询" Click="QueryName_Click"
                                                VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding GameName}" FontSize="16" FontWeight="SemiBold" />

                                    <!-- 兼容模式专属面板：主程序位置只在下拉框内显示（候选项为完整路径） -->
                                    <StackPanel x:Name="CompatPanel" Spacing="8" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      Header="游戏程序"
                                                      PlaceholderText="{Binding CompatStatus}"
                                                      ItemsSource="{Binding ExeCandidates}"
                                                      SelectedItem="{Binding SelectedExe, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                            <Button Grid.Column="1" Content="刷新"
                                                    Click="RefreshCompat_Click"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Bottom" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Click="StartOnlineFix_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                IsEnabled="{Binding CanStart}">
                                            <TextBlock Text="启动 480 联机" />
                                        </Button>
                                        <Button Click="StopOnlineFix_Click"
                                                IsEnabled="{Binding IsRunning}">
                                            <TextBlock Text="停止游戏" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="OtherPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">
                            <TextBlock Text="功能开发中"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
