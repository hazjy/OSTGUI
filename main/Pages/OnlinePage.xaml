<Page
    x:Class="OSTGUI.Pages.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,12">
            <TextBlock Text="联机" FontSize="24" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:Segmented Grid.Row="0" x:Name="OnlineSegmented"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnlineSegmented_SelectionChanged">
                <controls:SegmentedItem Content="480联机" IsSelected="True" />
                <controls:SegmentedItem Content="其他" />
            </controls:Segmented>
            <Grid Grid.Row="1">
                <Grid x:Name="OnlineFixPanel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">
                            <!-- 焦点锚点：WinUI 空白点击会把焦点投给 ScrollViewer 内第一个可聚焦控件（#4364），
                                 此处拦截，避免落到 AppID 输入框 -->
                            <Grid IsTabStop="True" TabIndex="0" Width="1" Height="1"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />
                            <Border Padding="24" CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="480 联机启动" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="以 Spacewar(480) 或自定义会话身份启动已入库游戏，启用 Steamworks 联机功能（需 Steam 在线）"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBox Header="AppID" Width="180"
                                                 Text="{Binding OnlineAppId, Mode=TwoWay}" />
                                        <Button Content="查询" Click="QueryName_Click"
                                                VerticalAlignment="Bottom" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding GameName}" FontSize="16" FontWeight="SemiBold" />

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="联机会话身份" FontSize="13" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <RadioButton GroupName="SessionIdentity" Content="默认身份（480）"
                                                         IsChecked="{Binding IsDefaultSession, Mode=TwoWay}" />
                                            <RadioButton GroupName="SessionIdentity" Content="自定义身份"
                                                         IsChecked="{Binding IsCustomSession, Mode=TwoWay}" />
                                            <TextBox Width="180" VerticalAlignment="Center"
                                                     PlaceholderText="会话身份 AppID"
                                                     Text="{Binding SessionAppId, Mode=TwoWay}"
                                                     IsEnabled="{Binding IsCustomSession}" />
                                        </StackPanel>
                                        <TextBlock Text="对端需使用相同会话身份；可选带 Steam Input 手柄配置的免费 AppID"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Click="StartOnlineFix_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                IsEnabled="{Binding CanStart}">
                                            <TextBlock Text="启动联机" />
                                        </Button>
                                        <Button Click="StopOnlineFix_Click"
                                                IsEnabled="{Binding IsRunning}">
                                            <TextBlock Text="停止游戏" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="OtherPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">
                            <TextBlock Text="功能开发中"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
