<Page
    x:Class="OSTGUI.Pages.OnlinePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:OSTGUI.Views"
    >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,32,40,12">
            <TextBlock Text="联机" FontSize="32" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="40,0,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:Segmented Grid.Row="0" x:Name="OnlineSegmented"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnlineSegmented_SelectionChanged">
                <controls:SegmentedItem Content="内核原生" IsSelected="True" Height="40" MinHeight="40" />
                <controls:SegmentedItem Content="其他" Height="40" MinHeight="40" />
            </controls:Segmented>

            <!-- 两种联机方式各是一个独立 UserControl：各自的 x:Name/命名空间互不可见，
                 单选用 RadioButtons 容器分组（不靠 GroupName 全局分组），
                 共用状态只走 ViewModel（SessionIndex / SessionAppId）。 -->
            <Grid Grid.Row="1">
                <views:OnlineFixView x:Name="FixView" />
                <views:OtherOnlineView x:Name="OtherView" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Page>
