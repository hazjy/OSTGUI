<UserControl
    x:Class="OSTGUI.Views.OtherOnlineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="920" HorizontalAlignment="Center" Padding="0,16,0,40">
            <!-- 焦点锚点：同 480 页，拦截空白点击的焦点投递 -->
            <Grid IsTabStop="True" TabIndex="0" Width="1" Height="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />

            <!-- 内容块 1：模式 -->
            <Border Width="560" Padding="24" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ComboBox x:Name="OnlineModeCombo" MinWidth="240" HorizontalAlignment="Left"
                          SelectedIndex="{Binding OtherModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="宿主会话（推荐）" />
                    <ComboBoxItem Content="文件会话" />
                </ComboBox>
            </Border>

            <!-- 内容块 2：输入与启停（两种方式共用，靠上面的下拉分派） -->
            <Border Width="560" Padding="24" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="HostGameAppIdBox" Header="游戏 AppID" Width="180"
                                     Text="{Binding HostGameAppId, Mode=TwoWay}" />
                            <Button Content="查询" Click="QueryHostGameExe_Click"
                                    VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding HostGameExePath}" FontSize="13"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="协议AppID" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <!-- 同上：不写 GroupName，隐式分组按直接父级，天然和 480 视图互不干扰 -->
                            <RadioButton Content="默认（480）"
                                         IsChecked="{Binding IsDefaultSession, Mode=TwoWay}" />
                            <RadioButton Content="自定义"
                                         IsChecked="{Binding IsCustomSession, Mode=TwoWay}" />
                            <TextBox Width="180" VerticalAlignment="Center"
                                     PlaceholderText="AppID"
                                     Text="{Binding SessionAppId, Mode=TwoWay}"
                                     IsEnabled="{Binding IsCustomSession}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="Start_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{Binding CanStart}"
                                AutomationProperties.Name="启动游戏"
                                ToolTipService.ToolTip="启动游戏">
                            <SymbolIcon Symbol="Play" />
                        </Button>
                        <Button Click="Stop_Click"
                                IsEnabled="{Binding IsRunning}"
                                AutomationProperties.Name="停止游戏"
                                ToolTipService.ToolTip="停止游戏">
                            <SymbolIcon Symbol="Stop" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 内容块 3：启动前置检查（Steam 运行 / 内核已装 / 已入库）
                 每项一块、横排一行，文案 = 名称：就绪 / 名称：错误；鼠标悬停有细则。
                 样式先占位，后续再调。 -->
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Border Width="170" Padding="16" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="联机需要 Steam 在线并已登录">
                    <TextBlock Text="{Binding SteamCheckText}" FontSize="14" HorizontalAlignment="Center" />
                </Border>
                <Border Width="170" Padding="16" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="会话身份靠内核生效（dwmapi / xinput1_4 / OpenSteamTool 三件套）">
                    <TextBlock Text="{Binding KernelCheckText}" FontSize="14" HorizontalAlignment="Center" />
                </Border>
                <Border Width="170" Padding="16" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="该 AppID 须已入库（lua 里有 addappid），宿主会话才能洗白身份">
                    <TextBlock Text="{Binding LibraryCheckText}" FontSize="14" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
