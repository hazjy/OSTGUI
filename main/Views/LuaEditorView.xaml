<UserControl
    x:Class="OSTGUI.Views.LuaEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="820" MinHeight="480" HorizontalAlignment="Center">

    <!-- 应用内 Lua 编辑器：RichEditBox + 手写词法上色。
         ⚠️ AOT：本视图不用 {Binding}（源生成成员在 AOT 下绑定提供器看不到，见 REF-AOT适配 §1），
         所有文本都在 code-behind 直接赋值。 -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <Button Content="addappid" FontSize="12" Padding="8,4" Click="InsertAppId_Click"
                    ToolTipService.ToolTip="解锁本体：addappid(AppID)" />
            <Button Content="addappid+密钥" FontSize="12" Padding="8,4" Click="InsertDepotKey_Click"
                    ToolTipService.ToolTip="解锁 depot 并注入解密密钥：addappid(depot, 1, &quot;64 位 hex&quot;)；第二参数内核忽略，密钥必须 64 字符" />
            <Button Content="addtoken" FontSize="12" Padding="8,4" Click="InsertToken_Click"
                    ToolTipService.ToolTip="受限 app 需要令牌：addtoken(AppID, &quot;令牌&quot;)" />
            <Button Content="setManifestid" FontSize="12" Padding="8,4" Click="InsertManifestId_Click"
                    ToolTipService.ToolTip="固定版本：setManifestid(depot, &quot;gid&quot;, 大小)；有则锁版本，无则自动更新" />
            <Button Content="注释/取消" FontSize="12" Padding="8,4" Click="ToggleComment_Click"
                    ToolTipService.ToolTip="给选中行加/去 &quot;-- &quot; 前缀" />
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <RichEditBox x:Name="Editor"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         FontSize="13"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" x:Name="DirtyText" FontSize="12" Margin="12,0,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
